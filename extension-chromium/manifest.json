{
  "manifest_version": 3,
  "name": "DownloadOS Handoff",
  "version": "0.1.0",
  "description": "Send ordinary download links from your browser to the DownloadOS desktop app.",
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html"
}
